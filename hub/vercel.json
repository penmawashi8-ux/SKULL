{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/workbox-(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/blog/poko-light-plus-5x6.html",
      "destination": "/blog/poko-light-plus-5x5.html",
      "permanent": true
    },
    {
      "source": "/games/g-board-app",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/games/racing-board",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/games/:id(bomb|pig-tail|keiba|page-one|coup|poko-light|shinkei|reversi|gomoku|marubatsu|sugoroku|daifugo|babanuki|sevens)",
      "destination": "/games/:id.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    }
  ]
}
